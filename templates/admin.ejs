<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>🛡 Admin Panel — Keeedum AI</title>
  <link rel="stylesheet" href="/static/style.css">
</head>
<body class="buy-page">

  <div class="buy-wrap">

    <!-- HEADER -->
    <div class="buy-header">
      <div class="buy-header-left">
        <a href="/" class="buy-back buy-back-highlight">← กลับหน้าหลัก</a>
      </div>
      <h1 class="login-title">🛡 Admin Panel</h1>
      <a href="/logout" class="buy-logout">🚪 ออกจากระบบ</a>
    </div>

    <!-- TABS -->
    <div class="pay-tabs" style="margin-bottom:24px;">
      <button class="pay-tab active" data-tab="pending" onclick="showTab('pending')">
        ⏳ รออนุมัติ
      </button>
      <button class="pay-tab" data-tab="addtime" onclick="showTab('addtime')">
        ⏰ เพิ่มเวลา
      </button>
      <button class="pay-tab" data-tab="users" onclick="showTab('users')">
        👥 Users
      </button>
    </div>

    <!-- ═══ TAB: PENDING ═══ -->
    <div id="tab-pending">
      <h2 class="buy-section">📋 รายการรออนุมัติ</h2>
      <button class="buy-status-link" onclick="loadPending()">🔄 โหลดใหม่</button>
      <div id="pendingList" style="margin-top:16px;">
        <div class="buy-empty">กำลังโหลด...</div>
      </div>
    </div>

    <!-- ═══ TAB: ADD TIME ═══ -->
    <div id="tab-addtime" style="display:none;">

      <h2 class="buy-section">⏰ เพิ่มเวลาให้สมาชิก</h2>

      <div class="buy-pay-box">
        <div class="buy-pay-row">
          <span>👤 ชื่อผู้ใช้</span>
          <input id="addUser" class="admin-note" placeholder="เช่น user1"
                 list="userList" autocomplete="off">
          <datalist id="userList"></datalist>
        </div>

        <div style="margin-top:12px; text-align:center;">
          <button class="buy-status-link" onclick="checkUser()">🔍 ตรวจสอบสถานะ</button>
        </div>
      </div>

      <div id="userInfo" class="buy-pay-box" style="display:none;"></div>

      <h2 class="buy-section">⚙️ ตั้งค่า</h2>
      <div class="buy-pay-box">

        <div class="buy-pay-row">
          <span>โหมด</span>
          <select id="addMode" class="admin-note" onchange="toggleMode()">
            <option value="days">📅 เพิ่มเป็นวัน</option>
            <option value="hours">⏱ เพิ่มเป็นชั่วโมง</option>
            <option value="seconds">⚡ เพิ่มเป็นวินาที</option>
            <option value="absolute">🎯 ตั้งวันหมดอายุตรง ๆ</option>
          </select>
        </div>

        <div class="buy-pay-row" id="addAmountWrap">
          <span>จำนวน</span>
          <input id="addAmount" type="number" value="30" min="1" max="3650"
                 class="admin-note">
        </div>

        <div class="buy-pay-row" id="addAbsWrap" style="display:none;">
          <span>วันหมดอายุ</span>
          <input id="addAbs" type="datetime-local" class="admin-note">
        </div>

        <div class="buy-pay-row">
          <span>หมายเหตุ</span>
          <input id="addNote" class="admin-note" placeholder="optional">
        </div>
      </div>

      <div class="quick-btns" style="margin-top:16px; display:flex; gap:8px; flex-wrap:wrap;">
        <button class="buy-back" onclick="quickAdd(1)">+1 วัน</button>
        <button class="buy-back" onclick="quickAdd(3)">+3 วัน</button>
        <button class="buy-back" onclick="quickAdd(7)">+7 วัน</button>
        <button class="buy-back" onclick="quickAdd(30)">+30 วัน</button>
        <button class="buy-back" onclick="quickAdd(90)">+90 วัน</button>
        <button class="buy-back" onclick="quickAdd(365)">+1 ปี</button>
      </div>

      <div style="margin-top:20px; display:flex; gap:10px; flex-wrap:wrap;">
        <button class="buy-submit" onclick="doAddTime()" style="margin:0; flex:1;">
          ✅ เพิ่มเวลา
        </button>
        <button class="buy-back" onclick="resetAddForm()">🔄 ล้างฟอร์ม</button>
      </div>

      <div id="addResult" style="margin-top:16px;"></div>
    </div>

    <!-- ═══ TAB: USERS ═══ -->
    <div id="tab-users" style="display:none;">
      <h2 class="buy-section">👥 รายชื่อสมาชิก</h2>

      <div class="buy-pay-box" style="margin-bottom:16px;">
        <div style="display:flex; gap:10px;">
          <input id="userSearch" class="admin-note"
                 placeholder="ค้นหา..." oninput="renderUsers()" style="flex:1;">
          <button class="buy-status-link" onclick="loadUsers()">🔄 โหลดใหม่</button>
        </div>
      </div>

      <div id="usersList">
        <div class="buy-empty">กำลังโหลด...</div>
      </div>
    </div>

  </div>

  <div class="toast" id="toast"></div>

  <script>
    window.CSRF_TOKEN = "<%= csrf_token %>";
  </script>

  <script>
  const CSRF = window.CSRF_TOKEN;
  let allUsers = [];

  function showToast(msg, type = 'ok') {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.style.background = type === 'err' ? 'var(--bad)' : 'var(--ok)';
    t.style.color = type === 'err' ? '#fff' : '#000';
    t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 2400);
  }

  function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, c => ({
      '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'
    }[c]));
  }

  function escapeJs(s) {
    return String(s).replace(/[\\'"\n\r]/g, c => ({
      '\\':'\\\\', "'":"\\'", '"':'\\"', '\n':'\\n', '\r':'\\r'
    }[c]));
  }

  // ─── TABS ─────────────────────────────────────────────
  function showTab(name) {
    document.querySelectorAll('.pay-tab').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('[id^="tab-"]').forEach(t => t.style.display = 'none');

    document.querySelector(`.pay-tab[data-tab="${name}"]`).classList.add('active');
    document.getElementById('tab-' + name).style.display = 'block';

    if (name === 'users') loadUsers();
    if (name === 'addtime') loadUserDatalist();
  }

  // ─── PENDING ──────────────────────────────────────────
  async function loadPending() {
    const box = document.getElementById('pendingList');
    box.innerHTML = '<div class="buy-empty">กำลังโหลด...</div>';
    try {
      const r = await fetch('/api/admin/pending');
      const j = await r.json();

      if (!j.ok || !j.items?.length) {
        box.innerHTML = '<div class="buy-empty">ไม่มีรายการรออนุมัติ</div>';
        return;
      }

      box.innerHTML = j.items.map(p => `
        <div class="admin-item">
          <div class="admin-item-head">
            <span><b>#${p.id} · ${escapeHtml(p.user)}</b></span>
            <span style="color:var(--accent); font-weight:900;">฿${p.price}</span>
          </div>
          <div style="font-size:12px; color:var(--dim);">
            📦 ${escapeHtml(p.pkg_name)}
          </div>
          ${p.slip_url ? `
            <div class="admin-slip">
              <img src="${p.slip_url}" alt="slip"
                   onclick="window.open('${p.slip_url}','_blank')">
            </div>
          ` : ''}
          <div class="admin-actions">
            <button class="admin-approve" onclick="approve(${p.id})">✅ อนุมัติ</button>
            <button class="admin-reject" onclick="reject(${p.id})">❌ ปฏิเสธ</button>
          </div>
        </div>
      `).join('');
    } catch (e) {
      box.innerHTML = `<div class="buy-empty" style="color:var(--bad);">Error: ${e.message}</div>`;
    }
  }

  async function approve(id) {
    if (!confirm('อนุมัติ #' + id + '?')) return;
    const r = await fetch('/api/admin/approve', {
      method: 'POST',
      headers: {'Content-Type':'application/json', 'X-CSRF-Token': CSRF},
      body: JSON.stringify({id}),
    });
    const j = await r.json();
    showToast(j.ok ? '✅ อนุมัติแล้ว' : ('❌ ' + j.error), j.ok ? 'ok' : 'err');
    loadPending();
  }

  async function reject(id) {
    const note = prompt('เหตุผลที่ปฏิเสธ:', 'สลิปไม่ถูกต้อง');
    if (note === null) return;
    const r = await fetch('/api/admin/reject', {
      method: 'POST',
      headers: {'Content-Type':'application/json', 'X-CSRF-Token': CSRF},
      body: JSON.stringify({id, note}),
    });
    const j = await r.json();
    showToast(j.ok ? 'ปฏิเสธแล้ว' : ('❌ ' + j.error), j.ok ? 'ok' : 'err');
    loadPending();
  }

  // ─── ADD TIME ─────────────────────────────────────────
  function toggleMode() {
    const m = document.getElementById('addMode').value;
    document.getElementById('addAmountWrap').style.display = m === 'absolute' ? 'none' : 'flex';
    document.getElementById('addAbsWrap').style.display    = m === 'absolute' ? 'flex' : 'none';
  }

  async function checkUser() {
    const u = document.getElementById('addUser').value.trim();
    if (!u) return showToast('ใส่ชื่อ user ก่อน', 'err');

    const box = document.getElementById('userInfo');
    box.style.display = 'block';
    box.innerHTML = 'กำลังตรวจสอบ...';

    try {
      const r = await fetch('/api/admin/user_status?user=' + encodeURIComponent(u));
      const j = await r.json();

      if (!j.ok) {
        box.innerHTML = `<span style="color:var(--bad);">❌ ${escapeHtml(j.error || 'ไม่พบ user')}</span>`;
        return;
      }

      const color = j.remaining > 0 ? 'var(--ok)' : 'var(--bad)';
      box.innerHTML = `
        <div class="buy-pay-row"><span>👤 ชื่อผู้ใช้</span><strong>${escapeHtml(j.user)}</strong></div>
        <div class="buy-pay-row"><span>⏰ เวลาคงเหลือ</span><strong style="color:${color};">${escapeHtml(j.remaining_text)}</strong></div>
        <div class="buy-pay-row"><span>📅 หมดอายุ</span><strong>${escapeHtml(j.expires_text)}</strong></div>
        <div class="buy-pay-row"><span>💰 กระเป๋า</span><strong>฿${(j.wallet_balance || 0).toFixed(2)}</strong></div>
        <div class="buy-pay-row" style="border-bottom:none;"><span>💸 จ่ายสะสม</span><strong>฿${(j.total_paid || 0).toFixed(2)}</strong></div>
      `;
    } catch (e) {
      box.innerHTML = `<span style="color:var(--bad);">Error: ${e.message}</span>`;
    }
  }

  async function doAddTime() {
    const u = document.getElementById('addUser').value.trim();
    if (!u) return showToast('ใส่ชื่อ user ก่อน', 'err');

    const mode = document.getElementById('addMode').value;
    const note = document.getElementById('addNote').value.trim();

    let body = { user: u, note };
    let url;

    if (mode === 'absolute') {
      const dt = document.getElementById('addAbs').value;
      if (!dt) return showToast('เลือกวันหมดอายุ', 'err');
      body.expires_at = new Date(dt).getTime() / 1000;
      url = '/api/admin/set_time';
    } else {
      const amt = parseInt(document.getElementById('addAmount').value || '0');
      if (amt <= 0) return showToast('จำนวนต้องมากกว่า 0', 'err');
      if (mode === 'days') body.days = amt;
      else if (mode === 'hours') body.hours = amt;
      else body.seconds = amt;
      url = '/api/admin/add_time';
    }

    const box = document.getElementById('addResult');
    box.innerHTML = '<div class="buy-empty">⏳ กำลังดำเนินการ...</div>';

    try {
      const r = await fetch(url, {
        method: 'POST',
        headers: {'Content-Type':'application/json', 'X-CSRF-Token': CSRF},
        body: JSON.stringify(body),
      });
      const j = await r.json();

      if (j.ok) {
        box.innerHTML = `
          <div class="buy-note" style="border-left-color:var(--ok); background:rgba(16,185,129,0.08);">
            ✅ สำเร็จ!<br>
            👤 <b>${escapeHtml(j.user)}</b><br>
            ${j.days_added ? `⏰ เพิ่ม: ${j.days_added} วัน<br>` : ''}
            📅 หมดอายุใหม่: <b>${escapeHtml(j.new_expires || j.expires_text || '')}</b>
          </div>
        `;
        checkUser();
      } else {
        box.innerHTML = `<div class="buy-note" style="border-left-color:var(--bad); background:rgba(239,68,68,0.08); color:var(--bad);">❌ ${escapeHtml(j.error || 'ไม่สำเร็จ')}</div>`;
      }
    } catch (e) {
      box.innerHTML = `<div class="buy-note" style="color:var(--bad);">❌ Error: ${e.message}</div>`;
    }
  }

  function resetAddForm() {
    document.getElementById('addUser').value = '';
    document.getElementById('addAmount').value = '30';
    document.getElementById('addNote').value = '';
    document.getElementById('userInfo').style.display = 'none';
    document.getElementById('addResult').innerHTML = '';
  }

  function quickAdd(days) {
    const u = document.getElementById('addUser').value.trim();
    if (!u) return showToast('ใส่ชื่อ user ก่อน', 'err');
    document.getElementById('addMode').value = 'days';
    toggleMode();
    document.getElementById('addAmount').value = days;
    doAddTime();
  }

  // ─── USERS ────────────────────────────────────────────
  async function loadUsers() {
    const box = document.getElementById('usersList');
    box.innerHTML = '<div class="buy-empty">กำลังโหลด...</div>';
    try {
      const r = await fetch('/api/admin/list_users');
      const j = await r.json();

      if (!j.ok) {
        box.innerHTML = `<div class="buy-empty" style="color:var(--bad);">${escapeHtml(j.error || 'โหลดไม่ได้')}</div>`;
        return;
      }

      allUsers = j.items || [];
      renderUsers();
    } catch (e) {
      box.innerHTML = `<div class="buy-empty" style="color:var(--bad);">Error: ${e.message}</div>`;
    }
  }

  function renderUsers() {
    const q = document.getElementById('userSearch').value.toLowerCase().trim();
    const filtered = q ? allUsers.filter(u => u.username.toLowerCase().includes(q)) : allUsers;

    const box = document.getElementById('usersList');

    if (!filtered.length) {
      box.innerHTML = '<div class="buy-empty">ไม่พบสมาชิก</div>';
      return;
    }

    box.innerHTML = filtered.map(u => `
      <div class="admin-item">
        <div class="admin-item-head">
          <span>
            <b>${escapeHtml(u.username)}</b>
            ${u.is_admin ? '<span class="buy-history-status" style="color:#fbbf24; border-color:#fbbf24; margin-left:8px;">Admin</span>' : ''}
          </span>
          <span style="color:var(--accent); font-weight:900;">
            ${u.remaining > 0 ? escapeHtml(u.remaining_text) : 'หมดอายุ'}
          </span>
        </div>
        <div class="admin-actions">
          <button class="buy-status-link" onclick="fillUser('${escapeJs(u.username)}')">
            ⏰ เพิ่มเวลา
          </button>
        </div>
      </div>
    `).join('');
  }

  async function loadUserDatalist() {
    try {
      const r = await fetch('/api/admin/list_users');
      const j = await r.json();
      if (!j.ok) return;
      const dl = document.getElementById('userList');
      dl.innerHTML = j.items.map(u =>
        `<option value="${escapeHtml(u.username)}">${u.remaining_text}</option>`
      ).join('');
    } catch (e) {}
  }

  function fillUser(username) {
    document.getElementById('addUser').value = username;
    showTab('addtime');
    checkUser();
  }

  // ─── INIT ─────────────────────────────────────────────
  loadPending();
  setInterval(loadPending, 15000);
  </script>

</body>
</html>